# Pripojenie na PostgreSQL. Na Railway sa doplní samo, keď pridáš databázu a prepojíš ju (${{Postgres.DATABASE_URL}}).
# Bez tejto premennej sa použije lokálna SQLite databáza v priečinku data/ (len na skúšanie).
DATABASE_URL=

# Heslo do admin panelu na /admin. Bez neho je admin vypnutý. Zvoľ dlhé a jedinečné.
ADMIN_PASSWORD=

# 0 = nenaplniť prázdnu databázu ukážkovými inzerátmi (na ostrú prevádzku nastav 0)
SEED_DEMO=1

# 1 = vyžadovať šifrované spojenie s databázou (niektorí poskytovatelia to chcú)
PGSSL=0
